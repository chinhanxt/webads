# Copy to .env.local for local dev, and paste the same values into the
# Cloudflare Pages project (Settings -> Environment variables) for production.
#
# Every value here is read at BUILD time and inlined into the exported HTML,
# because this is a static export (next.config.ts: output: 'export'). Changing
# any of them requires a rebuild/redeploy — editing them in the CF dashboard
# alone does nothing until the next build.
#
# Adsterra dashboard: https://beta.publishers.adsterra.com/websites


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Bare apex domain, no protocol, no trailing slash. Drives site.url, which in
# turn drives every canonical URL, the sitemap and robots.txt. Must match the
# domain you attach to the Cloudflare Pages project and the domain you add in
# Adsterra, or ad requests get rejected as off-domain.
NEXT_PUBLIC_SITE_DOMAIN=autoquotehub.com

# Set to exactly "false" to render grey placeholder boxes instead of live ad
# code. Any other value (or unset) means ads are on. Useful for local dev and
# for the first crawl by Google, before Adsterra approves the site.
NEXT_PUBLIC_ADS_ENABLED=true


# ---------------------------------------------------------------------------
# Adsterra — one-time setup
# ---------------------------------------------------------------------------
# 1. https://beta.publishers.adsterra.com/websites -> "Add website".
#    Enter the domain above, category "Finance", traffic type "Mainstream".
# 2. Wait for the site to move from "Pending" to "Approved" (usually < 24h,
#    they check that the domain resolves and serves real content — so deploy
#    first with NEXT_PUBLIC_ADS_ENABLED=false, then apply).
# 3. Open the approved website row -> "Add placement" and create the five
#    placements below, one at a time.
# ---------------------------------------------------------------------------

# Placement type: Banner, size 728x90 (desktop leaderboard).
# After creating it, Adsterra shows a code snippet containing
#   atOptions = { 'key' : 'abc123...', 'format' : 'iframe', ... }
# Paste ONLY the value of 'key' here — not the whole snippet, no quotes.
NEXT_PUBLIC_ADSTERRA_728=

# Placement type: Banner, size 300x250 (in-article rectangle).
# Same as above: copy the 'key' string out of that placement's atOptions.
NEXT_PUBLIC_ADSTERRA_300=

# Placement type: Banner, size 320x50 (mobile banner; replaces the 728x90
# below 768px). Again just the 'key' string from its atOptions snippet.
NEXT_PUBLIC_ADSTERRA_320=

# Placement type: Native Banner.
# Its snippet is a <script> tag plus an empty <div>. Copy the FULL src of the
# script tag, protocol-relative, e.g.
#   //pl27123456.effectiveratecpm.com/aa11bb22cc33.../invoke.js
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=

# From the SAME Native Banner snippet: the id attribute of the <div> that sits
# next to the script tag, e.g. container-aa11bb22cc33...
# Both this and NEXT_PUBLIC_ADSTERRA_NATIVE_SRC must be set or the native unit
# falls back to a placeholder.
NEXT_PUBLIC_ADSTERRA_NATIVE_ID=

# Placement type: Social Bar. Loads once site-wide from the root layout.
# Copy the full script src, protocol-relative, e.g.
#   //pl27123457.effectiveratecpm.com/dd44ee55ff66.../invoke.js
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=

# Placement type: Popunder. Also loads once site-wide.
# Copy the full script src, protocol-relative, same shape as the Social Bar.
# Leave blank if you would rather not run popunders — the rest still works.
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=


# ---------------------------------------------------------------------------
# Lead affiliate
# ---------------------------------------------------------------------------

# The quote-form destination behind every CTA button. Two tokens are replaced
# at click time:
#   {ZIP} -> the ZIP the visitor typed, or the city's default ZIP
#   {SUB} -> a sub-id identifying the page the click came from, for reporting
# Keep both tokens in the URL. If unset, a non-earning example.com URL is used.
NEXT_PUBLIC_AFFILIATE_URL=https://example-partner.com/auto?zip={ZIP}&sub={SUB}
